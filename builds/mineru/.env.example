# MinerU Docker image
MINERU_VERSION=3.1.0

# Port configurations
MINERU_PORT_OVERRIDE_VLLM=30000
MINERU_PORT_OVERRIDE_API=8000
MINERU_PORT_OVERRIDE_GRADIO=7860

# API server output root directory (inside container)
# Each task creates a UUID subdirectory under this path for isolation.
# The ZIP response returned to clients strips the UUID prefix automatically.
MINERU_API_OUTPUT_ROOT=/tmp/mineru-output
