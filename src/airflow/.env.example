# Apache Airflow Configuration

# Versions
# Airflow image tag (variant suffix python3.12 is recommended)
AIRFLOW_VERSION=3.3.2-python3.12
# PostgreSQL major version
POSTGRES_VERSION=16

# Port Configuration
# Host port for the Airflow UI / REST API (apiserver)
AIRFLOW_PORT_OVERRIDE=8080

# Airflow Core
# Initial admin username for the UI (created by airflow-init)
# WARNING: change the default password before exposing Airflow beyond localhost!
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Fernet key used to encrypt connections/variables in the metadata database.
# Leave empty for an ephemeral key (encrypted values are lost on container restart).
# Generate a stable key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
AIRFLOW_FERNET_KEY=
# User ID for file permissions on the ./logs, ./dags, ./plugins bind mounts.
# 50000 is the default inside the Airflow image.
# On Windows/macOS Docker Desktop any value works; on Linux set this to your own UID (e.g. `id -u`)
# so the scheduler can write task logs.
AIRFLOW_UID=50000
# Load the bundled example DAGs on startup
AIRFLOW_LOAD_EXAMPLES=false

# PostgreSQL Configuration
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Timezone
TZ=UTC

# Resource Limits - Airflow APIservers
AIRFLOW_APISERVER_CPU_LIMIT=1.0
AIRFLOW_APISERVER_CPU_RESERVATION=0.25
AIRFLOW_APISERVER_MEMORY_LIMIT=1G
AIRFLOW_APISERVER_MEMORY_RESERVATION=512M

# Resource Limits - Scheduler
AIRFLOW_SCHEDULER_CPU_LIMIT=1.0
AIRFLOW_SCHEDULER_CPU_RESERVATION=0.25
AIRFLOW_SCHEDULER_MEMORY_LIMIT=1G
AIRFLOW_SCHEDULER_MEMORY_RESERVATION=512M

# Resource Limits - DAG Processor
AIRFLOW_DAG_PROCESSOR_CPU_LIMIT=0.5
AIRFLOW_DAG_PROCESSOR_CPU_RESERVATION=0.1
AIRFLOW_DAG_PROCESSOR_MEMORY_LIMIT=1G
AIRFLOW_DAG_PROCESSOR_MEMORY_RESERVATION=256M

# Resource Limits - Triggerer
AIRFLOW_TRIGGERER_CPU_LIMIT=0.5
AIRFLOW_TRIGGERER_CPU_RESERVATION=0.1
AIRFLOW_TRIGGERER_MEMORY_LIMIT=1G
AIRFLOW_TRIGGERER_MEMORY_RESERVATION=256M

# Resource Limits - Airflow Init (one-shot DB migration + user creation)
AIRFLOW_INIT_CPU_LIMIT=0.5
AIRFLOW_INIT_CPU_RESERVATION=0.1
AIRFLOW_INIT_MEMORY_LIMIT=512M
AIRFLOW_INIT_MEMORY_RESERVATION=128M

# Resource Limits - PostgreSQL
POSTGRES_CPU_LIMIT=1.0
POSTGRES_CPU_RESERVATION=0.1
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_MEMORY_RESERVATION=256M
