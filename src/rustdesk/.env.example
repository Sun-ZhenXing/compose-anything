# RustDesk Server image version
RUSTDESK_VERSION=1.1.16

# Container timezone
TZ=UTC

# Advertised relay address in host:port form. The default only works for clients on this same Docker host.
# Before remote/LAN/WAN use, set this to the server address reachable by clients and the published relay port.
# Do not use the Compose service name. Do not include whitespace or multiple relay addresses.
RUSTDESK_RELAY_SERVER=127.0.0.1:21117

# Host TCP port for NAT test (must be ID port minus one if changing the ID port)
RUSTDESK_NAT_PORT_OVERRIDE=21115

# Shared host TCP and UDP port for ID/rendezvous service
RUSTDESK_ID_PORT_OVERRIDE=21116

# Host TCP port for relay service; also update RUSTDESK_RELAY_SERVER when changed
RUSTDESK_RELAY_PORT_OVERRIDE=21117

# Resource limits and reservations; defaults are starting points, not upstream minimums
RUSTDESK_CPU_LIMIT=1
RUSTDESK_MEMORY_LIMIT=256M
RUSTDESK_CPU_RESERVATION=0.1
RUSTDESK_MEMORY_RESERVATION=64M
