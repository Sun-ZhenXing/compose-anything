# Bifrost Gateway Version
BIFROST_VERSION=v2.0.0

# Token required for first-administrator setup; leave empty for a local no-auth instance
BIFROST_SETUP_TOKEN=

# Port to bind to on the host machine
BIFROST_PORT=28080

# Prometheus image version for the optional telemetry profile
PROMETHEUS_VERSION=v3.8.1
# Prometheus host port for the optional telemetry profile
PROMETHEUS_PORT=29090
# Grafana image version for the optional telemetry profile
GRAFANA_VERSION=12.3.1
# Grafana host port for the optional telemetry profile
GRAFANA_PORT=23000
# Grafana administrator username for the optional telemetry profile
GRAFANA_ADMIN_USER=admin
# Grafana administrator password for the optional telemetry profile
GRAFANA_ADMIN_PASSWORD=admin
