# Timezone (e.g., UTC, Asia/Shanghai, America/New_York)
TZ=UTC

# Utopia app image version (upstream pre-release, no stable tag yet; do not use latest)
UTOPIA_VERSION=0.1.0-rc5

# Postgres+pgvector image version for the database service
UTOPIA_DB_VERSION=pg16

# Full app image reference (override to use a mirror or a newer RC)
UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0-rc5

# Full database image reference (override to use a mirror)
UTOPIA_DB_IMAGE=pgvector/pgvector:pg16

# Host port for the Utopia web UI and API (container port 1516)
UTOPIA_PORT_OVERRIDE=1516

# Host port for PostgreSQL (container port 5432)
UTOPIA_DB_PORT_OVERRIDE=1517

# Database password for the utopia PostgreSQL user.
# Only takes effect on first initialization of the utopia_db_data volume.
# Changing it later requires updating UTOPIA_DATABASE_URL accordingly or recreating the volume.
# For evaluation you can keep the default, but set a strong password for shared/production use.
UTOPIA_DB_PASSWORD=utopia

# Secret used to sign JWT session tokens. Leave empty to let the server
# auto-generate one on first start and store it in the database.
# Set a long random value for production use.
UTOPIA_JWT_SECRET=

# Application secret key. Leave empty to let the server generate one
# and persist it as secret.key under the data volume (UTOPIA_DATA_DIR).
# Back it up together with the data volume; losing it invalidates existing sessions/secrets.
UTOPIA_SECRET_KEY=

# Allow open user registration. Keep true for first-time setup so you can
# register the first user (which becomes the system administrator),
# then set to false to prevent further self-registration.
UTOPIA_OPEN_REGISTRATION=true

# Maximum database connections for the app connection pool
UTOPIA_DB_MAX_CONNECTIONS=32

# App CPU limits
UTOPIA_CPU_LIMIT=2
UTOPIA_CPU_RESERVATION=0.1

# App memory limits
UTOPIA_MEMORY_LIMIT=2G
UTOPIA_MEMORY_RESERVATION=256M

# Database CPU limits
UTOPIA_DB_CPU_LIMIT=2
UTOPIA_DB_CPU_RESERVATION=0.1

# Database memory limits
UTOPIA_DB_MEMORY_LIMIT=2G
UTOPIA_DB_MEMORY_RESERVATION=512M
