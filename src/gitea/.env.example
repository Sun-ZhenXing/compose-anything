# Gitea Version
GITEA_VERSION=1.27.3-rootless

# Database configuration
GITEA_DB_TYPE=postgres
GITEA_POSTGRES_HOST=db:5432

# PostgreSQL settings
POSTGRES_VERSION=17.11
POSTGRES_USER=gitea
POSTGRES_PASSWORD=gitea
POSTGRES_DB=gitea

# Gitea ports
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# Gitea MCP server (optional, start with: docker compose --profile mcp up -d)
GITEA_MCP_VERSION=1.7.0
# Host port that exposes the MCP HTTP endpoint at /mcp
GITEA_MCP_PORT_OVERRIDE=3001
# Gitea URL as seen from inside the Compose network
GITEA_MCP_HOST=http://gitea:3000
# Personal access token created in Gitea under Settings > Applications.
# Leave empty to require the client to send its own Bearer token per request.
GITEA_MCP_ACCESS_TOKEN=
# Set to true to skip TLS verification when GITEA_MCP_HOST uses HTTPS
GITEA_MCP_INSECURE=false
# Set to true to hide tools that modify Gitea data
GITEA_MCP_READONLY=false
