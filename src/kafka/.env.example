# Kafka version (Confluent Platform version)
KAFKA_VERSION=8.3.2

# Kafka UI version
KAFKA_UI_VERSION=v0.7.2

# KRaft cluster ID (base64 UUID). Must stay stable for the lifetime of the kafka_data volume.
# Generate a new one with:
#   docker run --rm confluentinc/cp-kafka:8.3.2 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Timezone
TZ=UTC

# Port overrides (optional)
# KAFKA_BROKER_PORT_OVERRIDE=9092
# KAFKA_JMX_PORT_OVERRIDE=9999
