# OceanBase version
OCEANBASE_VERSION=4.4.2.1-101000022026050611

# Timezone
TZ=UTC

# Sys tenant root password
OB_SYS_PASSWORD=oceanbase

# Cluster configuration
OB_CLUSTER_NAME=obcluster
OB_TENANT_NAME=test
OB_TENANT_PASSWORD=oceanbase

# Resource limits
OB_MEMORY_LIMIT=8G
OB_DATAFILE_SIZE=10G
OB_LOG_DISK_SIZE=6G

# Port overrides (optional)
# OCEANBASE_SQL_PORT_OVERRIDE=2881
# OCEANBASE_RPC_PORT_OVERRIDE=2882
