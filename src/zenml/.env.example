# =============================================================================
# ZenML stack configuration
# Copy this file to `.env` and adjust values before starting:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Versions (prebuilt images only, no builds)
# -----------------------------------------------------------------------------
# ZenML server version. Browse tags: https://hub.docker.com/r/zenmldocker/zenml-server/tags
ZENML_VERSION=0.98.0

# MySQL version. Browse tags: https://hub.docker.com/_/mysql/tags
MYSQL_VERSION=8.4

# Adminer version (dev profile). Browse tags: https://hub.docker.com/_/adminer/tags
ADMINER_VERSION=4.8.1

# OpenTelemetry Collector Contrib version (metrics profile).
# Browse tags: https://hub.docker.com/r/otel/opentelemetry-collector-contrib/tags
OTEL_COLLECTOR_VERSION=0.112.0

# Prometheus version (metrics profile). Browse tags: https://hub.docker.com/r/prom/prometheus/tags
PROMETHEUS_VERSION=v2.53.1

# -----------------------------------------------------------------------------
# Port overrides
# -----------------------------------------------------------------------------
# Host port for the ZenML dashboard/API (default profile and dev SQLite variant).
ZENML_PORT_OVERRIDE=8080

# Host port for Adminer (dev profile).
ADMINER_PORT_OVERRIDE=8081

# Host port for Prometheus UI (metrics profile).
PROMETHEUS_PORT_OVERRIDE=9090

# Host port for the OTLP gRPC receiver (metrics profile).
OTEL_COLLECTOR_PORT_OVERRIDE=4317

# -----------------------------------------------------------------------------
# ZenML store (MySQL connection)
# -----------------------------------------------------------------------------
# Full store URL override. When set it takes precedence over the MySQL_* values
# below, which only pre-fill the compose default. Example:
#   mysql://zenml:zenml@mysql:3306/zenml
ZENML_STORE_URL=

# SSL settings for the MySQL-backed store (leave empty to disable TLS).
ZENML_STORE_SSL_CA=
ZENML_STORE_SSL_CERT=
ZENML_STORE_SSL_KEY=
# Verify the MySQL server certificate when connecting over TLS.
ZENML_STORE_SSL_VERIFY_SERVER_CERT=false

# Directory where ZenML persists local stores inside the container.
# Leave empty to use the image default.
ZENML_LOCAL_STORES_PATH=

# -----------------------------------------------------------------------------
# Secrets store
# -----------------------------------------------------------------------------
# Where ZenML stores secrets. Supported values:
#   (empty), sqlite, sql, aws, gcp, azure, hashicorp, custom
# `sql` keeps secrets in the main store encrypted with ZENML_SECRETS_STORE_ENCRYPTION_KEY.
ZENML_SECRETS_STORE_TYPE=

# Encryption key for `sql` secrets store (Fernet key):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENML_SECRETS_STORE_ENCRYPTION_KEY=

# AWS secrets-store credentials (only used with ZENML_SECRETS_STORE_TYPE=aws).
ZENML_SECRETS_STORE_AWS_ACCESS_KEY_ID=
ZENML_SECRETS_STORE_AWS_SECRET_ACCESS_KEY=

# GCP secrets-store credentials JSON (inline) for type=gcp.
ZENML_SECRETS_STORE_GCP_CREDENTIALS=

# Azure secrets-store credentials JSON (inline) for type=azure.
ZENML_SECRETS_STORE_AZURE_CREDENTIALS=

# HashiCorp Vault settings for type=hashicorp.
ZENML_SECRETS_STORE_HASHICORP_TOKEN=
ZENML_SECRETS_STORE_HASHICORP_URL=
ZENML_SECRETS_STORE_HASHICORP_MOUNT_PATH=

# Fully qualified class path of a custom secrets-store plugin for type=custom.
ZENML_SECRETS_STORE_CUSTOM_PLUGIN=

# NOTE: every secret-store setting above also has a BACKUP_ mirror prefix
# (e.g. ZENML_SECRETS_STORE_BACKUP_* is not required here because this file
# exposes the primary store; add BACKUP_ prefixed variants only if you switch
# ZENML_STORE_BACKUP_STRATEGY and need independent backup credentials).

# -----------------------------------------------------------------------------
# Store backup strategy
# -----------------------------------------------------------------------------
# How ZenML backs up the central store database. Supported values:
#   (empty = disabled), duplicated-in-memory, in-memory, mysqldump, mydumper, custom
ZENML_STORE_BACKUP_STRATEGY=

# Target database URL for the backup when using mydumper/mydumper-based strategies.
ZENML_STORE_BACKUP_DATABASE=

# Local directory where backups are written.
ZENML_STORE_BACKUP_DIRECTORY=

# Path to the mysqldump binary override (mysqldump strategy).
ZENML_STORE_BACKUP_MYSQLDUMP_BINARY_PATH=

# Path to the mydumper binary override (mydumper strategy).
ZENML_STORE_BACKUP_MYDUMPER_BINARY_PATH=

# Path to the myloader binary override (mydumper restore).
ZENML_STORE_BACKUP_MYLOADER_BINARY_PATH=

# Path to a custom backup strategy class (custom strategy).
ZENML_STORE_BACKUP_CUSTOM_BACKUP_STRATEGY=

# -----------------------------------------------------------------------------
# Server / authentication
# -----------------------------------------------------------------------------
# Deployment type must stay `docker` when running inside Compose.
ZENML_SERVER_DEPLOYMENT_TYPE=docker

# Automatically activate new users instead of requiring manual approval.
ZENML_SERVER_AUTO_ACTIVATE=true

# Default admin user created on FIRST START ONLY. Changing these afterwards
# does not update an already-initialized database.
ZENML_DEFAULT_USER_NAME=default
ZENML_DEFAULT_USER_PASSWORD=

# JWT signing key for sessions. Generate one with:
#   openssl rand -hex 32
# Leave empty on first run to let the server generate one (stored in the store).
ZENML_SERVER_JWT_SECRET_KEY=

# Public URL of the server if you expose it behind a reverse proxy / custom host.
ZENML_SERVER_SERVER_URL=

# Rate limiting for the public API.
ZENML_SERVER_RATE_LIMIT_ENABLED=false
ZENML_SERVER_RATE_LIMIT_REQUESTS_PER_SECOND=100

# Secure HTTP headers (leave empty for the server defaults).
ZENML_SERVER_SECURE_HEADERS_CONTENT_SECURITY_POLICY=
ZENML_SERVER_SECURE_HEADERS_PERMISSIONS_POLICY=
ZENML_SERVER_SECURE_HEADERS_STRICT_TRANSPORT_SECURITY=
ZENML_SERVER_SECURE_HEADERS_REFERRER_POLICY=
ZENML_SERVER_SECURE_HEADERS_X_CONTENT_TYPE_OPTIONS=

# -----------------------------------------------------------------------------
# Logging / telemetry
# -----------------------------------------------------------------------------
# Log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
ZENML_LOGGING_VERBOSITY=INFO

# Console log format: rich, plain or empty for default.
ZENML_CONSOLE_LOGGING_FORMAT=

# Set to true to strip colors from logs (useful for log collectors).
ZENML_LOGGING_COLORS_DISABLED=false

# Opt out of anonymous usage analytics (false = no telemetry sent).
ZENML_ANALYTICS_OPT_IN=false

# -----------------------------------------------------------------------------
# OpenTelemetry (empty endpoint = OTEL disabled)
# -----------------------------------------------------------------------------
# OTLP endpoint ZenML exports traces/metrics to. Point it at the otel-collector
# service when the metrics profile is enabled:
#   ZENML_SERVER_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ZENML_SERVER_OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name attached to exported telemetry.
ZENML_SERVER_OTEL_EXPORTER_SERVICE_NAME=zenml-server

# Whether to use plaintext (insecure) OTLP transport.
ZENML_SERVER_OTEL_EXPORTER_OTLP_INSECURE=true

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# Root password of the MySQL instance.
# CHANGE THIS before first start! It initializes the volume and cannot be
# changed afterwards without wiping mysql_data.
MYSQL_ROOT_PASSWORD=zenml-root-pw

# Application database and user created on first start.
MYSQL_DATABASE=zenml
MYSQL_USER=zenml
MYSQL_PASSWORD=zenml

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=UTC

# -----------------------------------------------------------------------------
# Resource limits
# -----------------------------------------------------------------------------
# MySQL
MYSQL_CPU_LIMIT=1.0
MYSQL_MEMORY_LIMIT=1G
MYSQL_CPU_RESERVATION=0.25
MYSQL_MEMORY_RESERVATION=512M

# ZenML server
ZENML_CPU_LIMIT=1.0
ZENML_MEMORY_LIMIT=1G
ZENML_CPU_RESERVATION=0.25
ZENML_MEMORY_RESERVATION=512M

# Adminer (dev profile)
ADMINER_CPU_LIMIT=0.5
ADMINER_MEMORY_LIMIT=256M
ADMINER_CPU_RESERVATION=0.1
ADMINER_MEMORY_RESERVATION=128M

# OTel collector (metrics profile)
OTEL_COLLECTOR_CPU_LIMIT=0.5
OTEL_COLLECTOR_MEMORY_LIMIT=512M
OTEL_COLLECTOR_CPU_RESERVATION=0.1
OTEL_COLLECTOR_MEMORY_RESERVATION=128M

# Prometheus (metrics profile)
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_CPU_RESERVATION=0.1
PROMETHEUS_MEMORY_RESERVATION=256M
