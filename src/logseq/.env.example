# Official Web App image digest (AMD64 and ARM64); upstream has no release-version tags.
# This image was built on 2025-05-26. Review upstream changes before replacing the digest.
LOGSEQ_IMAGE_DIGEST=sha256:de87c4a26986278b52f778d4d28c03e32d68a7c7f42bae128614bcaa3f26c231

# Optional registry mirror prefix, including the trailing slash.
# GLOBAL_REGISTRY=ghcr.io/

# Host interface; keep loopback unless a trusted HTTPS proxy needs another interface.
LOGSEQ_BIND_ADDRESS=127.0.0.1

# Host HTTP port; the container listens on port 80.
LOGSEQ_PORT_OVERRIDE=3001

# Container timezone.
TZ=UTC

# CPU and memory limits for the static Nginx server.
LOGSEQ_CPU_LIMIT=0.5
LOGSEQ_MEMORY_LIMIT=128M

# CPU and memory reservations.
LOGSEQ_CPU_RESERVATION=0.1
LOGSEQ_MEMORY_RESERVATION=32M
