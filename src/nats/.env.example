# Global registry prefix for all images (optional)
GLOBAL_REGISTRY=

# NATS Server version
NATS_VERSION=2.15.3-alpine3.22

# Client credentials
NATS_USER=admin
NATS_PASSWORD=password

# Port to bind to on the host machine (client connections)
NATS_PORT_OVERRIDE=4222

# Timezone (e.g., UTC, Asia/Shanghai, America/New_York)
TZ=UTC

# CPU limits
NATS_CPU_LIMIT=1.0
NATS_CPU_RESERVATION=0.1

# Memory limits
NATS_MEMORY_LIMIT=1G
NATS_MEMORY_RESERVATION=256M