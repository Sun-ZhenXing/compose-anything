# Memos image version
MEMOS_VERSION=0.30.0

# Host bind address. Keep 127.0.0.1 unless remote access is intentionally configured.
MEMOS_BIND_ADDRESS=127.0.0.1

# Host port mapped to Memos' fixed internal port 5230
MEMOS_PORT_OVERRIDE=5230

# Database driver: sqlite, postgres, or mysql. SQLite is the default.
MEMOS_DRIVER=sqlite

# Database connection string. Required when MEMOS_DRIVER is postgres or mysql.
# PostgreSQL example: postgres://user:password@host:port/dbname?sslmode=disable
# MySQL example: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
# MEMOS_DSN=

# Public URL of this Memos instance. Leave empty for private/local use.
# MEMOS_INSTANCE_URL=https://memos.example.com

# Timezone
TZ=UTC

# Resource limits
MEMOS_CPU_LIMIT=1.0
MEMOS_MEMORY_LIMIT=512M
MEMOS_CPU_RESERVATION=0.1
MEMOS_MEMORY_RESERVATION=128M
