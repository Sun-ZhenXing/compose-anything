# Official TriliumNext image version, pinned to the published digest.
TRILIUM_VERSION=v0.103.0@sha256:8e6bc939a6d5dbeed42d1b5b155bc790b1c28ca3ac414382d04d626903c62081

# Optional registry prefix, including a trailing slash when used.
GLOBAL_REGISTRY=

# Bind the first-setup web interface to localhost by default.
TRILIUM_BIND_ADDRESS=127.0.0.1
# Host port for the fixed container port 8080.
TRILIUM_PORT_OVERRIDE=8080

# Container timezone.
TZ=UTC

# Resource limits for the Trilium service.
TRILIUM_CPU_LIMIT=1.0
TRILIUM_MEMORY_LIMIT=1G
# Container log rotation limits.
TRILIUM_LOG_MAX_SIZE=100m
TRILIUM_LOG_MAX_FILE=3
