# Registry prefix, including a trailing slash when used.
GLOBAL_REGISTRY=

# Immutable AppFlowy Cloud release references. Change deliberately as a release unit.
APPFLOWY_CLOUD_VERSION=0.9.64@sha256:d6ba6df1d8dc43336f24e6bb24d58e9077be29477214e45ff9cafcbec2aec1b5
APPFLOWY_GOTRUE_VERSION=0.9.64@sha256:b6616aa6e0f93c7c8081f17a00018d06da6dae952efcfd23f3ca6444b4b19954
APPFLOWY_ADMIN_VERSION=0.9.64@sha256:7ce31fd818121e3b625be0464028af6a5e2a04b71455922fc3fe2c09f6280d14
APPFLOWY_POSTGRES_VERSION=0.8.1-pg16-bookworm
APPFLOWY_REDIS_VERSION=7.4.11-alpine3.21
APPFLOWY_MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
APPFLOWY_NGINX_VERSION=1.28.0-alpine

# Local-only secrets. Run `python3 setup.py` (or `py -3 setup.py` on Windows) to fill these.
APPFLOWY_POSTGRES_PASSWORD=
APPFLOWY_ADMIN_PASSWORD=
APPFLOWY_JWT_SECRET=
APPFLOWY_MINIO_ACCESS_KEY=
APPFLOWY_MINIO_SECRET_KEY=
APPFLOWY_ADMIN_OAUTH_CLIENT_SECRET=
APPFLOWY_GOTRUE_OPERATOR_TOKEN=
APPFLOWY_ADMIN_EMAIL=admin@example.com

# Keep the gateway local by default. Set APPFLOWY_BASE_URL when publishing elsewhere.
APPFLOWY_BIND_ADDRESS=127.0.0.1
APPFLOWY_PORT_OVERRIDE=8080
APPFLOWY_BASE_URL=http://localhost:8080
APPFLOWY_LOG_MAX_SIZE=100m
APPFLOWY_LOG_MAX_FILE=3

# Resource limits.
APPFLOWY_POSTGRES_CPU_LIMIT=1.0
APPFLOWY_POSTGRES_MEMORY_LIMIT=1G
APPFLOWY_REDIS_CPU_LIMIT=0.5
APPFLOWY_REDIS_MEMORY_LIMIT=256M
APPFLOWY_MINIO_CPU_LIMIT=1.0
APPFLOWY_MINIO_MEMORY_LIMIT=1G
APPFLOWY_GOTRUE_CPU_LIMIT=0.5
APPFLOWY_GOTRUE_MEMORY_LIMIT=256M
APPFLOWY_CLOUD_CPU_LIMIT=2.0
APPFLOWY_CLOUD_MEMORY_LIMIT=2G
APPFLOWY_ADMIN_CPU_LIMIT=0.5
APPFLOWY_ADMIN_MEMORY_LIMIT=256M
APPFLOWY_NGINX_CPU_LIMIT=0.25
APPFLOWY_NGINX_MEMORY_LIMIT=64M
