# Compose environment for astron-agent.
# Copy this file to .env and adjust as needed: cp .env.example .env

# ============================================================================
# Registry & Versions
# ============================================================================

# Global registry prefix, prepended to all Docker Hub images (optional).
# Example: GLOBAL_REGISTRY=docker.io/myteam/
GLOBAL_REGISTRY=

# astron-agent image tag (published on ghcr.io/iflytek/astron-agent)
ASTRON_AGENT_VERSION=1.1.2

# Middleware image versions
POSTGRES_VERSION=14
MYSQL_VERSION=8.4.6
REDIS_VERSION=7
NGINX_VERSION=1.25-alpine
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
BUSYBOX_VERSION=1.35
CASDOOR_VERSION=v2.67.0
CASDOOR_MYSQL_VERSION=8.4.6

# Timezone (used by postgres, mysql, console-hub)
TZ=UTC

# ============================================================================
# Port Overrides
# ============================================================================

# Host port of the nginx reverse proxy (the web UI entry point)
ASTRON_PORT_OVERRIDE=80

# MinIO maintenance ports; always bound to 127.0.0.1 on the host.
MINIO_PORT_OVERRIDE=18998
MINIO_CONSOLE_PORT_OVERRIDE=18999

# Casdoor admin UI port (only active with the `auth` profile)
CASDOOR_PORT_OVERRIDE=8000

# Internal service ports inside the private Compose network.
# Only change these if you route traffic to them directly.
CORE_TENANT_PORT=5052
CORE_DATABASE_PORT=7990
CORE_RPA_PORT=17198
CORE_LINK_PORT=18888
CORE_AITOOLS_PORT=18668
CORE_AGENT_PORT=17870
CORE_KNOWLEDGE_PORT=20010
CORE_WORKFLOW_PORT=7880

# Container-side MinIO ports. These are also baked into the OSS endpoint
# defaults below, so change them together with the OSS_* endpoints.
EXPOSE_MINIO_PORT=18998
EXPOSE_MINIO_CONSOLE_PORT=18999

# ============================================================================
# Middleware Credentials & Connections
# ============================================================================

# PostgreSQL
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark123
# Connection settings for consumers; keep the defaults while middleware
# runs inside this stack.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=root
MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD:-root123}
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://mysql:3306/astron_console?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&createDatabaseIfNotExist=true

# Redis
REDIS_PASSWORD=123
REDIS_DATABASE=0
REDIS_IS_CLUSTER=false
REDIS_CLUSTER_ADDR=
REDIS_EXPIRE=3600
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

# Kafka plumbing (Kafka itself is not part of this stack; leave disabled).
KAFKA_ENABLE=0
KAFKA_TIMEOUT=60
KAFKA_SERVERS=kafka:29092

# ============================================================================
# Object Storage (bundled MinIO)
# ============================================================================

# Bundled MinIO credentials. They are zero-configuration by default like the
# other private middleware; override when exposing MinIO beyond loopback /
# the private network.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# OSS client settings. The bundled MinIO image does not create a separate
# application user, so these MUST equal the MinIO root credentials above;
# a startup preflight (minio-credentials-check) enforces this. Use a Compose
# override if you swap bundled MinIO for external S3.
OSS_TYPE=s3
OSS_ENDPOINT=http://minio:${EXPOSE_MINIO_PORT}
OSS_ACCESS_KEY_ID=${MINIO_ROOT_USER:-minioadmin}
OSS_ACCESS_KEY_SECRET=${MINIO_ROOT_PASSWORD:-minioadmin123}
OSS_BUCKET_NAME=workflow
OSS_TTL=157788000

# Public-facing origin used for presigned download URLs. Browsers resolve
# *.localhost to host loopback while containers reach the same signed host
# via MinIO's minio.localhost network alias. Remote clients need a separately
# protected TLS proxy configured to this exact origin (scheme + host +
# optional port, no path/query/fragment).
OSS_REMOTE_ENDPOINT=http://minio.localhost:${EXPOSE_MINIO_PORT}
OSS_BUCKET_CONSOLE=console-oss
OSS_PRESIGN_EXPIRY_SECONDS_CONSOLE=600

# ============================================================================
# Internal Credentials (auto-generated on first startup)
# ============================================================================

# Leave empty to auto-generate strong values persisted in named volumes.
# Optional explicit overrides: WORKFLOW_INTERNAL_API_KEY must be 32-128 safe
# characters; TENANT_KEY/TENANT_SECRET must be distinct 32-50 character values.
WORKFLOW_INTERNAL_API_KEY=
TENANT_KEY=
TENANT_SECRET=
TENANT_ID=680ab54f

# Skill sandbox internal tokens. Leave empty to let console-hub generate and
# persist one token each in shared private volumes. Explicit values must be
# at least 32 characters (e.g. openssl rand -hex 32) and must differ from
# each other.
SKILL_SANDBOX_ARTIFACT_UPLOAD_TOKEN=
SKILL_SANDBOX_RUNTIME_CREDENTIAL_TOKEN=
SKILL_SANDBOX_ARTIFACT_BUCKET=workflow-artifacts
SKILL_SANDBOX_ARTIFACT_MAX_FILE_SIZE=20MB
SKILL_SANDBOX_ARTIFACT_MAX_ACTIVE_FILES_PER_WORKFLOW=1000
SKILL_SANDBOX_ARTIFACT_MAX_ACTIVE_TOTAL_SIZE_PER_WORKFLOW=1GB
SKILL_SANDBOX_ARTIFACT_ALLOWED_EXTENSIONS=txt,md,csv,json,pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,ppt,pptx,zip

# ============================================================================
# Observability (disabled by default)
# ============================================================================

# OTLP exporter
OTLP_ENABLE=0
OTLP_ENDPOINT=127.0.0.1:4317
OTLP_METRIC_TIMEOUT=3000
OTLP_METRIC_EXPORT_INTERVAL_MILLIS=3000
OTLP_METRIC_EXPORT_TIMEOUT_MILLIS=3000
OTLP_TRACE_TIMEOUT=3000
OTLP_TRACE_MAX_QUEUE_SIZE=2048
OTLP_TRACE_SCHEDULE_DELAY_MILLIS=3000
OTLP_TRACE_MAX_EXPORT_BATCH_SIZE=2048
OTLP_TRACE_EXPORT_TIMEOUT_MILLIS=3000

# Langfuse trace export (disabled by default)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Generate a separate random value; use the same value in Agent and Workflow.
ASTRON_TRACE_CONTEXT_SECRET=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_CAPTURE_INPUT_OUTPUT=false
LANGFUSE_MAX_ATTRIBUTE_LENGTH=8192
LANGFUSE_ENVIRONMENT=default
LANGFUSE_RELEASE=

# ELK upload switches for the agent service
UPLOAD_NODE_TRACE=true
UPLOAD_METRICS=true

# ============================================================================
# Application Ports & Console URLs
# ============================================================================

# Base address used to derive console/Casdoor URLs below.
HOST_BASE_ADDRESS=http://localhost

# Domain of the console. Also drives Casdoor's OAuth redirectUris:
# the casdoor entrypoint rewrites redirectUris to ${CONSOLE_DOMAIN}/callback.
CONSOLE_DOMAIN=${HOST_BASE_ADDRESS}:${ASTRON_PORT_OVERRIDE}

# Console frontend Casdoor branding; these win over VITE_CASDOOR_* build-time
# values. Only relevant together with the `auth` profile.
CONSOLE_CASDOOR_URL=${HOST_BASE_ADDRESS}:${CASDOOR_PORT_OVERRIDE}
CONSOLE_CASDOOR_ID=astron-agent-client
CONSOLE_CASDOOR_APP=astron-agent-app
CONSOLE_CASDOOR_ORG=built-in

# ============================================================================
# Casdoor / OAuth2 (only active with the `auth` profile)
# ============================================================================

# console-hub validates JWTs against this issuer/JWKS. Upstream defaults point
# at an `auth-server` URL; with the bundled auth profile set both to Casdoor.
OAUTH2_ISSUER_URI=${CONSOLE_CASDOOR_URL:-http://auth-server:8000}
OAUTH2_JWK_SET_URI=http://casdoor:8000/.well-known/jwks
OAUTH2_AUDIENCE=${CONSOLE_CASDOOR_ID:-your-oauth2-client-id}

# ============================================================================
# Component-specific Settings
# ============================================================================

# - Tenant service
DATABASE_DB_TYPE=mysql
DATABASE_USERNAME=${MYSQL_USER:-root}
DATABASE_PASSWORD=${MYSQL_PASSWORD:-root123}
DATABASE_URL=(mysql:3306)/tenant
DATABASE_MAX_OPEN_CONNS=5
DATABASE_MAX_IDLE_CONNS=5
LOG_PATH=log.txt

# - Memory database service
DATABASE_POSTGRES_DATABASE=sparkdb_manager
DATABASE_MYSQL_DATABASE=sparkdb_manager
DB_TYPE=postgresql

# - RPA service. The RPA runtime is NOT bundled in this stack; point these at
#   your own deployment (open source: https://github.com/iflytek/astron-rpa).
RPA_URL=https://newapi.iflyrpa.com
XIAOWU_RPA_TASK_CREATE_URL=${RPA_URL}/api/rpa-openapi/workflows/execute-async
XIAOWU_RPA_TASK_QUERY_URL=${RPA_URL}/api/rpa-openapi/executions

# - Link service
LINK_MYSQL_DB=spark-link

# - Agent service
SERVICE_HOST=0.0.0.0
SERVICE_WORKERS=1
SERVICE_RELOAD=false
SERVICE_WS_PING_INTERVAL=false
SERVICE_WS_PING_TIMEOUT=false
AGENT_MYSQL_DB=agent
AGENT_KAFKA_TOPIC=spark-agent-builder
GET_LINK_URL=http://core-link:18888/api/v1/tools
VERSIONS_LINK_URL=http://core-link:18888/api/v1/tools/versions
RUN_LINK_URL=http://core-link:18888/api/v1/tools/http_run
GET_WORKFLOWS_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/sparkflow/v1/protocol/get
WORKFLOW_SSE_BASE_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1
CHUNK_QUERY_URL=http://core-knowledge:${CORE_KNOWLEDGE_PORT:-20010}/knowledge/v1/chunk/query
LIST_MCP_PLUGIN_URL=http://core-link:18888/api/v1/mcp/tool_list
RUN_MCP_PLUGIN_URL=http://core-link:18888/api/v1/mcp/call_tool
APP_AUTH_HOST=core-tenant
APP_AUTH_PROT=http
# APP_AUTH credentials are derived from the generated tenant bootstrap secret.

# - Workflow service
WORKFLOW_MYSQL_DB=workflow
WORKFLOW_KAFKA_TOPIC=spark-agent-builder
RUNTIME_ENV=dev
# Optional code-node executor override. Leave empty for the built-in
# LangChain/Pyodide isolated sandbox; set to "disabled" only when Code nodes
# should be intentionally unavailable.
CODE_EXEC_TYPE=

# - Workflow service-to-service API URLs
WORKFLOW_CHAT_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1/chat/completions
WORKFLOW_DEBUG_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1/debug/chat/completions
WORKFLOW_RESUME_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1/resume

# - Console hub
REDIS_DATABASE_CONSOLE=1
ADMIN_UID=9999
APP_URL=http://core-tenant:${CORE_TENANT_PORT:-5052}/v2/app
KNOWLEDGE_URL=http://core-knowledge:${CORE_KNOWLEDGE_PORT:-20010}/knowledge
TOOL_URL=http://core-link:18888
AGENT_URL=http://core-agent:${CORE_AGENT_PORT:-17870}
TOOL_RPA_URL=http://core-rpa:17198
WORKFLOW_URL=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}
SPARK_DB_URL=http://core-database:${CORE_DATABASE_PORT:-7990}
SPARK_DB_TYPE=postgresql
# Local model service (open source: https://github.com/iflytek/astron-xmod-shim)
LOCAL_MODEL_URL=http://127.0.0.1:33778

# MaaS platform integration (leave the loopback placeholders unless you run MaaS)
MAAS_WORKFLOW_VERSION=http://127.0.0.1:8080/workflow/version
MAAS_SYNCHRONIZE_WORK_FLOW=http://127.0.0.1:8080/workflow
MAAS_PUBLISH=http://127.0.0.1:8080/workflow/publish
MAAS_CLONE_WORK_FLOW=http://127.0.0.1:8080/workflow/internal-clone
MAAS_GET_INPUTS=http://127.0.0.1:8080/workflow/get-inputs-info
MAAS_CAN_PUBLISH_URL=http://127.0.0.1:8080/workflow/can-publish
MAAS_PUBLISH_API=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1/publish
MAAS_AUTH_API=http://core-workflow:${CORE_WORKFLOW_PORT:-7880}/workflow/v1/auth
MAAS_MCP_REGISTER=http://127.0.0.1:8080/workflow/release
MAAS_WORKFLOW_CONFIG=http://127.0.0.1:8080/workflow/get-flow-advanced-config
BOT_API_CBM_BASE_URL=ws(s)://spark-api-open.xf-yun.com
BOT_API_MAAS_BASE_URL=${CONSOLE_DOMAIN}
TENANT_CREATE_APP=http://core-tenant:${CORE_TENANT_PORT:-5052}/v2/app
TENANT_GET_APP_DETAIL=http://core-tenant:${CORE_TENANT_PORT:-5052}/v2/app/details
TENANT_VERIFY_APP_AUTH=http://core-tenant:${CORE_TENANT_PORT:-5052}/v2/app/key/verify

# WeChat platform integration for console-hub
WECHAT_COMPONENT_APPID=your-wechat-component-appid
WECHAT_COMPONENT_SECRET=your-wechat-component-secret
WECHAT_TOKEN=your-wechat-token
WECHAT_ENCODING_AES_KEY=your-wechat-encoding-aes-key

# ============================================================================
# Miscellaneous
# ============================================================================

# Service availability zone (dx, hf, gz)
SERVICE_LOCATION=hf

# Health check tuning
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=60

# ============================================================================
# Resource Limits
# ============================================================================

# One-shot init jobs
INTERNAL_CREDENTIALS_INIT_CPU_LIMIT=0.1
INTERNAL_CREDENTIALS_INIT_MEMORY_LIMIT=64M
MINIO_CREDENTIALS_CHECK_CPU_LIMIT=0.1
MINIO_CREDENTIALS_CHECK_MEMORY_LIMIT=64M

# Middleware
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_CPU_RESERVATION=0.1
POSTGRES_MEMORY_RESERVATION=256M
MYSQL_CPU_LIMIT=1.5
MYSQL_MEMORY_LIMIT=2G
MYSQL_CPU_RESERVATION=0.1
MYSQL_MEMORY_RESERVATION=512M
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.1
REDIS_MEMORY_RESERVATION=128M
MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=1G
MINIO_CPU_RESERVATION=0.1
MINIO_MEMORY_RESERVATION=256M
NGINX_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=512M
NGINX_CPU_RESERVATION=0.1
NGINX_MEMORY_RESERVATION=64M

# Core business services (pattern: CORE_<NAME>_*)
CORE_TENANT_CPU_LIMIT=2.0
CORE_TENANT_MEMORY_LIMIT=2G
CORE_TENANT_CPU_RESERVATION=0.1
CORE_TENANT_MEMORY_RESERVATION=512M
CORE_DATABASE_CPU_LIMIT=2.0
CORE_DATABASE_MEMORY_LIMIT=2G
CORE_DATABASE_CPU_RESERVATION=0.1
CORE_DATABASE_MEMORY_RESERVATION=512M
CORE_RPA_CPU_LIMIT=2.0
CORE_RPA_MEMORY_LIMIT=2G
CORE_RPA_CPU_RESERVATION=0.1
CORE_RPA_MEMORY_RESERVATION=512M
CORE_LINK_CPU_LIMIT=2.0
CORE_LINK_MEMORY_LIMIT=2G
CORE_LINK_CPU_RESERVATION=0.1
CORE_LINK_MEMORY_RESERVATION=512M
CORE_AITOOLS_CPU_LIMIT=2.0
CORE_AITOOLS_MEMORY_LIMIT=2G
CORE_AITOOLS_CPU_RESERVATION=0.1
CORE_AITOOLS_MEMORY_RESERVATION=512M
CORE_AGENT_CPU_LIMIT=2.0
CORE_AGENT_MEMORY_LIMIT=2G
CORE_AGENT_CPU_RESERVATION=0.1
CORE_AGENT_MEMORY_RESERVATION=512M
CORE_KNOWLEDGE_CPU_LIMIT=2.0
CORE_KNOWLEDGE_MEMORY_LIMIT=2G
CORE_KNOWLEDGE_CPU_RESERVATION=0.1
CORE_KNOWLEDGE_MEMORY_RESERVATION=512M
CORE_WORKFLOW_CPU_LIMIT=2.0
CORE_WORKFLOW_MEMORY_LIMIT=4G
CORE_WORKFLOW_CPU_RESERVATION=0.1
CORE_WORKFLOW_MEMORY_RESERVATION=512M

# Console services
CONSOLE_FRONTEND_CPU_LIMIT=0.5
CONSOLE_FRONTEND_MEMORY_LIMIT=512M
CONSOLE_FRONTEND_CPU_RESERVATION=0.1
CONSOLE_FRONTEND_MEMORY_RESERVATION=64M
CONSOLE_HUB_CPU_LIMIT=2.0
CONSOLE_HUB_MEMORY_LIMIT=2G
CONSOLE_HUB_CPU_RESERVATION=0.1
CONSOLE_HUB_MEMORY_RESERVATION=512M

# Auth profile services
CASDOOR_CPU_LIMIT=1.0
CASDOOR_MEMORY_LIMIT=1G
CASDOOR_CPU_RESERVATION=0.1
CASDOOR_MEMORY_RESERVATION=256M
CASDOOR_MYSQL_CPU_LIMIT=1.5
CASDOOR_MYSQL_MEMORY_LIMIT=2G
CASDOOR_MYSQL_CPU_RESERVATION=0.1
CASDOOR_MYSQL_MEMORY_RESERVATION=512M
