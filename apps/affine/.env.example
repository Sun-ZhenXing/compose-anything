# Official AFFiNE image registry prefix, including the trailing slash, and version.
GHCR_REGISTRY=ghcr.io/
AFFINE_VERSION=0.27.4

# Optional global registry prefix for PostgreSQL and Redis, including a trailing slash.
GLOBAL_REGISTRY=
# Pinned PostgreSQL with pgvector image version.
AFFINE_POSTGRES_VERSION=0.8.1-pg16-bookworm
# Pinned Redis image version.
AFFINE_REDIS_VERSION=7.4.11-alpine3.21

# Bind AFFiNE to localhost by default.
AFFINE_BIND_HOST=127.0.0.1
# Published host port; update the external URL below when changing it.
AFFINE_PORT_OVERRIDE=3010
# Public URL used by AFFiNE; update it when changing the published port or host.
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010

# Credentials are for LOCAL EVALUATION ONLY; replace them before first startup in production.
# Use only letters, numbers, hyphen, and underscore in all three values for DATABASE_URL validity.
AFFINE_POSTGRES_USER=affine
AFFINE_POSTGRES_DB=affine
AFFINE_POSTGRES_PASSWORD=affine-local-password

# Disable indexing; no external search engine is included.
AFFINE_INDEXER_ENABLED=false
# Container timezone.
TZ=UTC

# CPU and memory limits.
AFFINE_CPU_LIMIT=2.0
AFFINE_MEMORY_LIMIT=2G
AFFINE_MIGRATION_CPU_LIMIT=2.0
AFFINE_MIGRATION_MEMORY_LIMIT=2G
AFFINE_POSTGRES_CPU_LIMIT=1.0
AFFINE_POSTGRES_MEMORY_LIMIT=1G
AFFINE_REDIS_CPU_LIMIT=0.5
AFFINE_REDIS_MEMORY_LIMIT=256M

# Container log rotation limits.
AFFINE_LOG_MAX_SIZE=100m
AFFINE_LOG_MAX_FILE=3
