# Official SiYuan image version, pinned to the published multi-architecture digest.
SIYUAN_VERSION=v3.8.2@sha256:af1442205fd60a8f5710c46c7e4c92bf3c8c1c9405026823496e4459f821549c

# Optional registry prefix, including a trailing slash when used.
GLOBAL_REGISTRY=

# Bind the web interface to localhost by default.
SIYUAN_BIND_ADDRESS=127.0.0.1
# Host port for the fixed container port 6806.
SIYUAN_PORT_OVERRIDE=6806

# Required workspace web access code. Run setup.py or make init to generate it.
SIYUAN_ACCESS_AUTH_CODE=

# UID and GID used by the official entrypoint after its root bootstrap.
SIYUAN_PUID=1000
SIYUAN_PGID=1000
# Container timezone.
TZ=UTC

# Resource limits for the SiYuan service.
SIYUAN_CPU_LIMIT=1.0
SIYUAN_MEMORY_LIMIT=1G
# Container log rotation limits.
SIYUAN_LOG_MAX_SIZE=100m
SIYUAN_LOG_MAX_FILE=3
